PORT=3000
MONGODB_URI=
MONGODB_DB=lifelens
USE_AI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Email needs SMTP_HOST and either SMTP_FROM or SMTP_USER.
# SMTP_PASS is also required when SMTP_USER is set; port/TLS values are optional.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
